# SentriAI Environment Configuration Template
# Copy this file to .env and configure your environment variables

# Application Settings
PROJECT_NAME="SentriAI"
API_V1_STR="/api/v1"

# Database (Default: SQLite for zero-config startup; or PostgreSQL with pgvector)
DATABASE_URL="sqlite:///./data/sentri_ai.db"
# Example PostgreSQL URL with pgvector:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sentriai"

# Security & Authentication
JWT_SECRET="your-super-secure-jwt-secret-key-here"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SMTP Email Configuration (Real Email OTP Delivery)
# For Gmail SMTP:
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Enter your Gmail address as SMTP_USERNAME and the 16-char App Password as SMTP_PASSWORD
EMAIL_PROVIDER="smtp"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME="your-gmail-address@gmail.com"
SMTP_PASSWORD="your-16-char-app-password"
EMAIL_FROM="SentriAI <your-gmail-address@gmail.com>"

# LLM Configuration (Microsoft Foundry / Gemini / OpenAI / Local Heuristic fallback)
LLM_PROVIDER="auto"
# Microsoft Foundry Project Endpoint format: https://<resource>.services.ai.azure.com/api/projects/<project-name>
# Example: https://sentri-ai-resource.services.ai.azure.com/api/projects/sentri-ai
# Note: Do NOT append /openai/v1/responses here; the client automatically connects to the Responses API.
AZURE_AI_PROJECT_ENDPOINT=
AZURE_AI_MODEL=gpt-5-mini
GEMINI_API_KEY=""
OPENAI_API_KEY=""
LLM_MODEL="gemini-1.5-flash"
EMBEDDING_MODEL="text-embedding-004"

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]
