# Environment and secrets (NEVER commit real credentials)
.env
.env.*
.env.local
.env.development
.env.test
.env.production
!.env.example
!**/.env.example

# Dependencies
node_modules/
**/node_modules/
jspm_packages/
.pnp
.pnp.js

