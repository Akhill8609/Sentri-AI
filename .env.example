# SentriAI Root Environment Configuration Template
# For backend configuration, see backend/.env.example
# For frontend configuration, see frontend/.env.example

# Backend Settings
PROJECT_NAME="SentriAI"
API_V1_STR="/api/v1"
DATABASE_URL="sqlite:///./data/sentri_ai.db"
JWT_SECRET="your-super-secure-jwt-secret-key-here"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SMTP Email Settings (Gmail SMTP)
EMAIL_PROVIDER="smtp"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME="your-gmail-address@gmail.com"
SMTP_PASSWORD="your-16-char-app-password"
EMAIL_FROM="SentriAI <your-gmail-address@gmail.com>"

# LLM Providers (Microsoft Foundry / Gemini / OpenAI / Local fallback)
LLM_PROVIDER="auto"
# Microsoft Foundry Project Endpoint format: https://<resource>.services.ai.azure.com/api/projects/<project-name>
# Example: https://sentri-ai-resource.services.ai.azure.com/api/projects/sentri-ai
# Note: Do NOT append /openai/v1/responses here; the client automatically connects to the Responses API.
AZURE_AI_PROJECT_ENDPOINT=
AZURE_AI_MODEL=gpt-5-mini
GEMINI_API_KEY=""
OPENAI_API_KEY=""
LLM_MODEL="gemini-1.5-flash"
EMBEDDING_MODEL="text-embedding-004"

# Frontend Settings
VITE_API_BASE_URL=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]
